# Intelligent Document Intelligence Platform Environment Configuration

# Flask Server Config
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=docintel-super-secret-production-key-change-me-392847239
JWT_SECRET_KEY=jwt-docintel-ultra-secure-token-secret-key-849204820
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration
# Local SQLite default (Zero-friction local dev):
DATABASE_URL=sqlite:///docintel.db
# Production PostgreSQL (with pgvector support):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docintel_db

# File Storage & Limits
UPLOAD_FOLDER=storage/uploads
PROCESSED_FOLDER=storage/processed
MAX_CONTENT_LENGTH=52428800 # 50 MB in bytes

# Vector & AI Provider Configuration
# Providers: 'fallback' (TextRank + TF-IDF Vectorizer), 'openai', 'ollama', 'huggingface'
AI_PROVIDER=fallback
EMBEDDING_PROVIDER=fallback
LLM_PROVIDER=fallback

# External API Keys (Optional - System works completely offline in fallback mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OCR Settings
TESSERACT_CMD= # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract

# Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@docintel.io
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_USERNAME=AdminUser
SEED_DEMO_EMAIL=demo@docintel.io
SEED_DEMO_PASSWORD=DemoPassword123!
SEED_DEMO_USERNAME=DemoUser
